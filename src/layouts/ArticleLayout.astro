---
import BaseLayout from "./BaseLayout.astro";
import { serializeJsonLd } from "../lib/serialize-json-ld";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  /** Canonical path for SEO, e.g. "/articles/my-post/". */
  canonicalPath: string;
  /** Author name for structured data. */
  authorName?: string;
}

const { title, description, pubDate, updatedDate, canonicalPath, authorName } =
  Astro.props;

const format = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: authorName ? { "@type": "Person", name: authorName } : undefined,
};
---

<BaseLayout
  title={`${title} · astro-learning-lab`}
  description={description}
  canonicalPath={canonicalPath}
  ogType="article"
  publishedTime={pubDate}
  updatedTime={updatedDate}
>
  <script
    type="application/ld+json"
    set:html={serializeJsonLd(jsonLd)}
    slot="head"
  />
  <article class="prose">
    <header>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={pubDate.toISOString()}>Published {format(pubDate)}</time
        >
        {
          updatedDate && (
            <span>
              {" · "}
              <time datetime={updatedDate.toISOString()}>
                Updated {format(updatedDate)}
              </time>
            </span>
          )
        }
      </p>
    </header>
    <slot />
  </article>
</BaseLayout>

<style>
  .prose {
    max-width: var(--prose-width);
    padding-block: 2.5rem 1rem;
  }

  .prose header {
    margin-bottom: 2rem;
  }

  .prose h1 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    letter-spacing: -0.02em;
  }

  .meta {
    color: var(--fg-muted);
    font-size: 0.92rem;
  }

  .prose :global(h2) {
    margin-top: 2.2em;
    font-size: 1.4rem;
  }

  .prose :global(h3) {
    margin-top: 1.8em;
    font-size: 1.15rem;
  }
</style>
