---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";

interface Props {
  title: string;
  description: string;
  /** Relative canonical path, e.g. "/articles/". Defaults to Astro.url.pathname. */
  canonicalPath?: string;
  ogType?: "website" | "article";
  publishedTime?: Date;
  updatedTime?: Date;
  /** hreflang alternates: [{ locale, url }] */
  alternates?: { locale: string; url: URL }[];
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  ogType,
  publishedTime,
  updatedTime,
  alternates,
} = Astro.props;

const canonicalURL = new URL(canonicalPath, Astro.site ?? Astro.url);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- Client-side routing with full DOM swaps: pages stay HTML-first,
		     navigations feel instant, islands re-hydrate per directive.
		     Scripts must be swap-aware (see FavoriteButton). -->
    <ClientRouter />
    <SEO
      title={title}
      description={description}
      canonicalURL={canonicalURL}
      ogType={ogType}
      publishedTime={publishedTime}
      updatedTime={updatedTime}
      alternates={alternates}
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <!-- tabindex="-1": lets the skip link transfer focus programmatically. -->
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
    width: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  .skip-link {
    position: absolute;
    inset-inline-start: 1rem;
    top: -100%;
    z-index: 100;
    padding: 0.5rem 1rem;
    background: var(--accent);
    color: var(--accent-fg);
    border-radius: var(--radius);
  }

  .skip-link:focus {
    top: 1rem;
  }

  main:focus {
    outline: none;
  }
</style>
