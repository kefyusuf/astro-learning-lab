---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "About · astro-learning-lab";
const description =
  "What astro-learning-lab is, the principles it follows and how it is built.";
---

<BaseLayout title={pageTitle} description={description}>
  <div class="prose">
    <h1>About this project</h1>
    <p>
      <code>astro-learning-lab</code> is a developer knowledge platform used as a
      teaching vehicle for Astro. It is built phase by phase, each phase introducing
      a small number of concepts with tests and documentation.
    </p>

    <h2>Principles</h2>
    <ul>
      <li>HTML first: zero client JavaScript unless a feature demands it.</li>
      <li>Rendering decisions are made per route.</li>
      <li>Every byte of client JS must justify itself.</li>
      <li>Duplication over the wrong abstraction.</li>
    </ul>

    <h2>How it is built</h2>
    <p>
      The project follows a 24-phase roadmap documented in
      <code>docs/learning/roadmap.md</code>. Architecture decisions are recorded
      as ADRs, and the concept glossary grows as phases complete.
    </p>
  </div>
</BaseLayout>

<style>
  .prose {
    max-width: var(--prose-width);
    padding-block: 2.5rem 1rem;
  }

  .prose h1 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    letter-spacing: -0.02em;
  }
</style>
