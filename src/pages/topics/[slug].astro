---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard, {
  type ArticleCardEntry,
} from "../../components/ArticleCard.astro";
import { topics, getArticlesByTopic, type Article } from "../../data/articles";

export function getStaticPaths() {
  return topics.map((topic) => ({
    params: { slug: topic.slug },
  }));
}

const { slug } = Astro.params;
const topic = topics.find((topic) => topic.slug === slug);

if (!topic) {
  return Astro.redirect("/404");
}

const topicArticles = getArticlesByTopic(topic.slug);

const toCardEntry = (article: Article): ArticleCardEntry => ({
  slug: article.slug,
  data: {
    title: article.title,
    description: article.description,
    pubDate: article.pubDate,
  },
});
---

<BaseLayout
  title={`${topic.name} · Topics · astro-learning-lab`}
  description={topic.description}
>
  <div class="page-head">
    <h1>{topic.name}</h1>
    <p>{topic.description}</p>
  </div>

  <div class="grid">
    {
      topicArticles.map((article) => (
        <ArticleCard article={toCardEntry(article)} />
      ))
    }
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: 2.5rem 1.5rem;
    max-width: var(--prose-width);
  }

  .page-head p {
    color: var(--fg-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1rem;
  }
</style>
