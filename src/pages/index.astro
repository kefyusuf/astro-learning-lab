---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ArticleCard from "../components/ArticleCard.astro";
import TopicCard from "../components/TopicCard.astro";
import { withBase } from "../lib/base";
import { isPublished, sortByPubDateDesc } from "../lib/content";
import { fetchRepoStats } from "../lib/stats";

const featured = sortByPubDateDesc(
  (await getCollection("articles", isPublished)).filter(
    (article) => article.data.featured,
  ),
).slice(0, 3);

const latest = sortByPubDateDesc(
  await getCollection("articles", isPublished),
).slice(0, 3);

const topics = (await getCollection("topics")).sort(
  (a, b) => a.data.order - b.data.order,
);
const articles = await getCollection("articles", isPublished);
const repoStats = await fetchRepoStats();

const countForTopic = (topicId: string) =>
  articles.filter((article) =>
    article.data.topics.some((ref) => ref.id === topicId),
  ).length;
---

<BaseLayout
  title="astro-learning-lab - learn Astro by building"
  description="A developer knowledge platform built to learn Astro from zero - articles, guides and topics rendered to plain HTML."
>
  <Hero
    title="Learn Astro by building a real content platform"
    description="A practical, phase-based curriculum. Every feature of this site exists to exercise one Astro concept - rendering, islands, content collections, server logic - and the docs explain every decision."
  >
    <div class="cta-row">
      <a
        class="button primary"
        href={withBase("/docs/learning/roadmap/")}
        data-astro-reload
      >
        Start Learning
      </a>
      <a class="button ghost" href={withBase("/docs/")}>Read the Docs</a>
    </div>
  </Hero>

  <section aria-labelledby="featured-heading">
    <h2 id="featured-heading">Featured</h2>
    <div class="grid">
      {featured.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>

  <section aria-labelledby="latest-heading">
    <h2 id="latest-heading">Latest articles</h2>
    <div class="grid">
      {latest.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>

  <section aria-labelledby="topics-heading">
    <h2 id="topics-heading">Topics</h2>
    <div class="grid">
      {
        topics.map((topic) => (
          <TopicCard
            topic={{
              slug: topic.id,
              name: topic.data.name,
              description: topic.data.description,
              count: countForTopic(topic.id),
            }}
          />
        ))
      }
    </div>
  </section>

  <section aria-labelledby="stats-heading">
    <h2 id="stats-heading">This site runs on Astro</h2>
    <div class="stats" data-source={repoStats.source}>
      <div class="stat">
        <span class="value">
          {repoStats.stars.toLocaleString("en-US")}
        </span>
        <span class="label">GitHub stars</span>
      </div>
      <div class="stat">
        <span class="value">
          {repoStats.openIssues.toLocaleString("en-US")}
        </span>
        <span class="label">Open issues</span>
      </div>
      <p class="provenance">
        {
          repoStats.source === "fixture" ? (
            <em>Offline build - showing committed fixture data.</em>
          ) : (
            <em>
              Fetched at build time ·{" "}
              {new Date(repoStats.fetchedAt).toISOString().slice(0, 10)}
            </em>
          )
        }
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  section {
    padding-block: 1.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1rem;
  }

  .cta-row {
    margin-top: 1.75rem;
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .button {
    display: inline-block;
    padding: 0.65rem 1.4rem;
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 600;
  }

  .button.primary {
    background: var(--accent);
    color: var(--accent-fg);
  }

  .button.primary:hover {
    filter: brightness(1.08);
  }

  .button.ghost {
    border: 1px solid var(--border);
    color: var(--fg);
    background: var(--card-bg);
  }

  .button.ghost:hover {
    border-color: var(--accent);
  }

  .stats {
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
    align-items: baseline;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
    background: var(--card-bg);
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .stat .value {
    font-size: 1.7rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .stat .label {
    color: var(--fg-muted);
    font-size: 0.88rem;
  }

  .provenance {
    margin: 0;
    margin-left: auto;
    color: var(--fg-muted);
    font-size: 0.85rem;
  }
</style>
