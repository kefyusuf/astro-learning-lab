---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ArticleCard from "../components/ArticleCard.astro";
import TopicCard from "../components/TopicCard.astro";
import { isPublished, sortByPubDateDesc } from "../lib/content";

const featured = sortByPubDateDesc(
  (await getCollection("articles", isPublished)).filter(
    (article) => article.data.featured,
  ),
).slice(0, 3);

const latest = sortByPubDateDesc(
  await getCollection("articles", isPublished),
).slice(0, 3);

const topics = (await getCollection("topics")).sort(
  (a, b) => a.data.order - b.data.order,
);
const articles = await getCollection("articles", isPublished);

const countForTopic = (topicId: string) =>
  articles.filter((article) =>
    article.data.topics.some((ref) => ref.id === topicId),
  ).length;
---

<BaseLayout
  title="astro-learning-lab - learn Astro by building"
  description="A developer knowledge platform built to learn Astro from zero - articles, guides and topics rendered to plain HTML."
>
  <Hero
    title="Learn Astro by building a real content platform"
    description="This site is the living output of a phase-based Astro curriculum. Every feature exists to exercise one Astro concept - rendering, islands, content collections, server logic - and nothing more."
  >
    <p class="cta">
      <a class="button" href="/articles/">Browse articles</a>
    </p>
  </Hero>

  <section aria-labelledby="featured-heading">
    <h2 id="featured-heading">Featured</h2>
    <div class="grid">
      {featured.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>

  <section aria-labelledby="latest-heading">
    <h2 id="latest-heading">Latest articles</h2>
    <div class="grid">
      {latest.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>

  <section aria-labelledby="topics-heading">
    <h2 id="topics-heading">Topics</h2>
    <div class="grid">
      {
        topics.map((topic) => (
          <TopicCard
            topic={{
              slug: topic.id,
              name: topic.data.name,
              description: topic.data.description,
              count: countForTopic(topic.id),
            }}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  section {
    padding-block: 1.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1rem;
  }

  .button {
    display: inline-block;
    background: var(--accent);
    color: var(--accent-fg);
    padding: 0.6rem 1.2rem;
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 600;
  }

  .cta {
    margin-top: 1.5rem;
  }
</style>
