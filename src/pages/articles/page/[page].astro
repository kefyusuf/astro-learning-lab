---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
import Pagination from "../../../components/Pagination.astro";
import {
  isPublished,
  sortByPubDateDesc,
  ARTICLES_PAGE_SIZE,
} from "../../../lib/content";
import { paginate } from "../../../lib/paginate";
import { withBase } from "../../../lib/base";

export async function getStaticPaths() {
  const allArticles = await getCollection("articles", isPublished);
  const sorted = sortByPubDateDesc(allArticles);
  const totalPages = Math.max(1, Math.ceil(sorted.length / ARTICLES_PAGE_SIZE));

  // Page 1 lives at /articles/ (index route). This route owns pages 2..N.
  return Array.from({ length: totalPages - 1 }, (_, index) => ({
    params: { page: String(index + 2) },
  }));
}

const { page } = Astro.params;

const allArticles = await getCollection("articles", isPublished);
const result = paginate(
  sortByPubDateDesc(allArticles),
  ARTICLES_PAGE_SIZE,
  Number(page),
);
---

<BaseLayout
  title={`Articles, page ${result.pageNumber} · astro-learning-lab`}
  description="Articles about Astro - components, rendering, islands and content architecture."
>
  <div class="page-head">
    <h1>Articles</h1>
    <p>Concept-first articles from the astro-learning-lab curriculum.</p>
  </div>

  <div class="grid">
    {result.items.map((article) => <ArticleCard article={article} />)}
  </div>

  <Pagination
    baseUrl={withBase("/articles")}
    pageNumber={result.pageNumber}
    totalPages={result.totalPages}
  />
</BaseLayout>

<style>
  .page-head {
    padding-block: 2.5rem 1.5rem;
    max-width: var(--prose-width);
  }

  .page-head p {
    color: var(--fg-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1rem;
  }
</style>
