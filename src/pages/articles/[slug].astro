---
import { getCollection, getEntry, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import FavoriteButton from "../../components/FavoriteButton.astro";
import { isPublished, readingTime } from "../../lib/content";

export async function getStaticPaths() {
  const articles = await getCollection("articles", isPublished);
  return articles.map((article) => ({
    params: { slug: article.id },
  }));
}

const { slug } = Astro.params;
const entry = (await getCollection("articles")).find(
  (article) => article.id === slug,
);

if (!entry || !isPublished(entry)) {
  return Astro.redirect("/404");
}

const { Content } = await render(entry);
const author = await getEntry(entry.data.author);
const minutes = readingTime(entry.body ?? "");
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
>
  <p class="byline">
    By {author?.data.name} · {minutes} min read
  </p>
  <div class="actions">
    <FavoriteButton articleId={entry.id} articleTitle={entry.data.title} />
  </div>
  <Content />

  {
    entry.data.topics.length > 0 && (
      <aside class="topics">
        <h2>Topics</h2>
        <ul>
          {entry.data.topics.map((ref) => (
            <li>
              <a href={`/topics/${ref.id}/`}>{ref.id}</a>
            </li>
          ))}
        </ul>
      </aside>
    )
  }
</ArticleLayout>

<style>
  .byline {
    color: var(--fg-muted);
    font-size: 0.92rem;
    margin-bottom: 2rem;
  }

  .actions {
    margin-bottom: 1.5rem;
  }

  .topics {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .topics h2 {
    font-size: 1rem;
    color: var(--fg-muted);
  }

  .topics ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 0.75rem;
  }
</style>
