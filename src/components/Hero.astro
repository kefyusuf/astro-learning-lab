---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<section class="hero">
  <h1>{title}</h1>
  <p>{description}</p>
  <slot />
</section>

<style>
  .hero {
    padding-block: 4rem 3rem;
    text-align: center;
    max-width: 48rem;
    margin-inline: auto;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 5.5vw, 3.4rem);
    letter-spacing: -0.025em;
  }

  .hero p {
    font-size: 1.15rem;
    color: var(--fg-muted);
    max-width: 42rem;
    margin-inline: auto;
  }
</style>
