---
interface Props {
  topic: {
    slug: string;
    name: string;
    description: string;
    count: number;
  };
}

const { topic } = Astro.props;
---

<a class="topic-card" href={`/topics/${topic.slug}/`}>
  <h3>{topic.name}</h3>
  <p>{topic.description}</p>
  <span class="count">{topic.count} article{topic.count === 1 ? "" : "s"}</span>
</a>

<style>
  .topic-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.15rem 1.3rem;
    text-decoration: none;
    color: var(--fg);
    transition: border-color 0.15s ease;
  }

  .topic-card:hover {
    border-color: var(--accent);
  }

  .topic-card h3 {
    margin: 0;
    font-size: 1.08rem;
  }

  .topic-card p {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.92rem;
    flex: 1;
  }

  .count {
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 600;
  }
</style>
