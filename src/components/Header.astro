---
import { stripBase, withBase } from "../lib/base";

interface NavLink {
  href: string;
  label: string;
  /** Forces a full page load - used at the Starlight layout boundary. */
  reload?: boolean;
}

const links: NavLink[] = [
  { href: withBase("/articles/"), label: "Articles" },
  { href: withBase("/guides/"), label: "Guides" },
  { href: withBase("/topics/"), label: "Topics" },
  { href: withBase("/glossary/"), label: "Glossary" },
  { href: withBase("/about/"), label: "About" },
];

const currentPath = stripBase(Astro.url.pathname);

function isActive(href: string, current: string): boolean {
  if (href === "/") return current === "/";
  return current === href || current.startsWith(href);
}
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href={withBase("/")}>astro<span>-learning-lab</span></a>
    <nav aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                data-astro-reload={link.reload ? "" : undefined}
                aria-current={
                  isActive(link.href, currentPath) ? "page" : undefined
                }
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {
      /* Full reload into the Starlight docs shell: two layout systems do
        not share the client router. */
    }
    <a
      class="docs-link"
      href={withBase("/docs/")}
      data-astro-reload
      aria-current={isActive(withBase("/docs/"), currentPath)
        ? "page"
        : undefined}
    >
      Docs
    </a>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding: 0.85rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    font-weight: 700;
    text-decoration: none;
    color: var(--fg);
    letter-spacing: -0.01em;
  }

  .brand span {
    color: var(--fg-muted);
    font-weight: 500;
  }

  nav ul {
    display: flex;
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a,
  .docs-link {
    color: var(--fg-muted);
    text-decoration: none;
    font-size: 0.95rem;
    padding-block: 0.25rem;
  }

  nav a:hover,
  nav a[aria-current="page"],
  .docs-link:hover,
  .docs-link[aria-current="page"] {
    color: var(--accent);
  }

  nav a[aria-current="page"] {
    font-weight: 600;
  }

  .docs-link {
    font-weight: 600;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
  }

  @media (max-width: 40rem) {
    .inner {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>
