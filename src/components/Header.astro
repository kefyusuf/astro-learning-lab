---
import { getLocaleFromPath, uiFor } from "../lib/i18n";
import { stripBase, withBase } from "../lib/base";

const locale = getLocaleFromPath(stripBase(Astro.url.pathname));
const t = uiFor(locale);

interface NavLink {
  href: string;
  label: string;
  /** Forces a full page load - used at the Starlight layout boundary. */
  reload?: boolean;
}

const links: NavLink[] = [
  { href: withBase("/articles/"), label: t.nav.articles },
  { href: withBase("/guides/"), label: t.nav.guides },
  { href: withBase("/topics/"), label: t.nav.topics },
  { href: withBase("/glossary/"), label: t.nav.glossary },
  { href: withBase("/about/"), label: t.nav.about },
  // Full reload into the Starlight docs shell: two layout systems do
  // not share the client router.
  { href: withBase("/docs/"), label: "Docs", reload: true },
];

// Locale-prefixed paths (e.g. /tr/articles/) keep the current page's
// section when switching language; the home page maps to /tr/.
const currentPath = stripBase(Astro.url.pathname);

function isActive(href: string, current: string): boolean {
  const normalized =
    locale === "tr" ? current.replace(/^\/tr/, "") || "/" : current;
  if (href === "/") return normalized === "/";
  return normalized === href || normalized.startsWith(href);
}
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href={withBase("/")}>astro<span>{t.brandSuffix}</span></a>
    <nav aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                data-astro-reload={link.reload ? "" : undefined}
                aria-current={
                  isActive(link.href, currentPath) ? "page" : undefined
                }
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-label="Language">
      {
        locale === "tr" ? (
          <a
            class="lang"
            href={withBase(currentPath.replace(/^\/tr/, "") || "/")}
            lang="en"
            hreflang="en"
          >
            EN
          </a>
        ) : (
          <a
            class="lang"
            href={withBase(`/tr${currentPath === "/" ? "/" : currentPath}`)}
            lang="tr"
            hreflang="tr"
          >
            TR
          </a>
        )
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding: 0.85rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    font-weight: 700;
    text-decoration: none;
    color: var(--fg);
    letter-spacing: -0.01em;
  }

  .brand span {
    color: var(--fg-muted);
    font-weight: 500;
  }

  nav ul {
    display: flex;
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--fg-muted);
    text-decoration: none;
    font-size: 0.95rem;
    padding-block: 0.25rem;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--accent);
  }

  nav a[aria-current="page"] {
    font-weight: 600;
  }

  .lang {
    font-weight: 600;
    font-size: 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    text-decoration: none;
    color: var(--fg-muted);
  }

  .lang:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (max-width: 40rem) {
    .inner {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>
