# Copy to .env for local development. Never commit real secrets.

# Canonical site origin - used by astro.config for sitemap, RSS and
# canonical URLs. Read at CONFIG time via process.env (the config file
# runs in Node, before import.meta.env exists).
SITE_URL=https://astro-learning-lab.example.com

# Optional: POST feedback submissions to this webhook (e.g. Slack).
# Server-only: WITHOUT the PUBLIC_ prefix it is never bundled for the
# browser. Leave empty to log submissions to the server console.
FEEDBACK_WEBHOOK_URL=
