# Hosting-layer security headers for statically served files.
# Middleware (src/middleware.ts) covers on-demand routes; this file
# covers prerendered pages and static assets, which never pass
# through middleware in production (static hosting serves them
# before any server code runs).
# Keep in sync with src/lib/security-headers.ts - a unit test
# asserts the two stay consistent.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
