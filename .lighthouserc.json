{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm preview",
      "startServerReadyPattern": "Local|http://localhost:4321",
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/articles/",
        "http://localhost:4321/articles/islands-mental-model/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "skipAudits": ["canonical", "maskable-icon"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "resource-summary:script:size": [
          "error",
          { "maxNumericValue": 70, "aggregationMethod": "optimistic" }
        ],
        "resource-summary:total:size": [
          "error",
          { "maxNumericValue": 500, "aggregationMethod": "optimistic" }
        ]
      }
    }
  }
}
